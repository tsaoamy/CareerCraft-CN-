# ==========================================
# CareerCraft 生产环境变量
# 复制为 .env.production 或 .env.local 后填写
# ==========================================

# 【必填】JWT 签名密钥
JWT_SECRET=change-me-to-a-strong-random-string-at-least-32-chars

# CloudBase 云数据库（CloudRun 通常自动注入 TCB_ENV / TENCENTCLOUD_SECRETID）
USE_CLOUDBASE=true
CLOUDBASE_ENV_ID=careercraft-d4gfk3hi163786996
# TCB_ENV=careercraft-d4gfk3hi163786996

# SQLite 本地回退路径
DATABASE_PATH=./data/careercraft.db.sqlite

# 站点 URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=production
PORT=3000

# AI 服务（可选，不填则使用本地 mock 引擎）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=4096
